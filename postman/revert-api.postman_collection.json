    {
      "name": "Field Mappings",
      "description": "Field mapping endpoints for custom field configuration",
      "item": [
        {
          "name": "Get Field Mapping Config",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-revert-public-token",
                "value": "{{publicToken}}",
                "type": "text",
                "description": "Your public key, to be used on the frontend usually."
              },
              {
                "key": "x-revert-t-id",
                "value": "{{tenantId}}",
                "type": "text",
                "description": "The unique customer id used when the customer linked their account."
              },
              {
                "key": "x-revert-t-token",
                "value": "{{tempToken}}",
                "type": "text",
                "description": "The temp used to identify tenant."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/field-mapping",
              "host": ["{{baseUrl}}"],
              "path": ["field-mapping"]
            },
            "description": "Get field mappings configs for a connection"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has required fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('canAddCustomMapping');",
                  "    pm.expect(jsonData).to.have.property('mappableFields');",
                  "});"
                ]
              }
            }
          ]
